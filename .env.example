# ----------------------
# 108Heros Frontend — copy to `.env` and fill in. `.env` is gitignored.
# ----------------------
# Every key here is one the code actually reads. Keys that nothing reads do not
# belong in this file: a dead key looks load-bearing to the next person and gets
# carried forward forever. `NEXT_PUBLIC_ENV` and `AUTH_SECRET` used to live in
# the committed `.env` and were read nowhere in the tree -- they are gone.

# === Public (inlined into the browser bundle at build time — never secret) ===
# Browser-side API origin. src/utils/env.ts, next.config.ts (CSP connect-src).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8536"
# Identity-Platform origin. src/services/IdentityOtpService.ts calls this
# directly from the browser for phone/OTP register+login (not proxied through
# the backend) -- same split api-108jobs's own config/config.hjson
# identity.base_url documents. Required: without it the register page's
# phone step cannot request or verify a code. Mirrors 108jobs-flutter's
# IDENTITY_BASE_URL.
NEXT_PUBLIC_IDENTITY_BASE_URL="http://localhost:8090"
# Absolute base for generated links. src/utils/env.ts, src/utils/appConfig.ts.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Also the auth cookie name (src/utils/config.ts) — changing it logs everyone out.
NEXT_PUBLIC_APP_NAME="108Heros.com"
# Server-side static asset dir. Optional; src/utils/env.ts falls back to a path.
NEXT_STATIC_DIR="/_next/static"

# === Internal (server-side only, never reaches the browser) ===
# Backend origin the server proxies to. next.config.ts THROWS if this is unset
# in a production build rather than falling back to the staging backend, so a
# production deploy must set it. Left empty here on purpose.
API_INTERNAL_URL=

# === Media uploads (optional) ===
# Read by src/services/media/madUpload.ts. Leave NEXT_PUBLIC_MEDIA_GATEWAY_URL
# out and uploads keep going to the backend's own /account/files exactly as
# before — that is the default in every environment today, and it is what makes
# the MAD cutover safe to land before MAD is deployed.
#
# Set it and uploads go to the MAD gateway instead: portfolio images become
# public assets read straight from NEXT_PUBLIC_MEDIA_PUBLIC_URL, everything else
# stays private and is read back through the backend's own
# /api/v4/media-proxy/{assetId}, which re-checks who is asking.
#
# NEXT_PUBLIC_MEDIA_PUBLIC_URL defaults to the gateway, which is correct when
# one host serves both. Both are NEXT_PUBLIC_ because the browser talks to MAD
# directly — Next.js inlines them at build time, so a change needs a rebuild.
# NEXT_PUBLIC_MEDIA_GATEWAY_URL=
# NEXT_PUBLIC_MEDIA_PUBLIC_URL=
