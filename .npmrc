# The client is a private package in this org's registry, not a folder in this
# repo any more (Gate 3). Scope routing lives here so `pnpm install` finds it
# the same way in CI, in Docker and on a laptop.
#
# No secret in this file: the token is interpolated from the environment at
# install time. CI passes the workflow's GITHUB_TOKEN, which can read the
# package because 108heros-web was granted access to it; a developer exports a
# PAT with `read:packages`.
@108-plaza:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
